JWT_SECRET=change_this_to_a_long_random_secret_in_production
PORT=3001
# Comma-separated list of allowed frontends. On Render set this to your Pages URL.
# e.g. CLIENT_URL=https://deepak0kr0mishra.github.io,http://localhost:5173
CLIENT_URL=http://localhost:5173
# Where SQLite + uploads live. Locally defaults to <repo-root>/data.
# On Render this MUST match the disk mountPath in render.yaml.
DATA_DIR=./data
# Password for the fixed admins (Admin_01..Admin_05).
# - If SET: applied on EVERY boot, even resetting existing fixed-admin
#   passwords — set this in the Render dashboard to recover a lockout.
# - If UNSET: fresh installs use the default in server/src/db.js; existing
#   passwords are never touched.
# ADMIN_PASSWORD=(set in Render dashboard if you need to override/recover)

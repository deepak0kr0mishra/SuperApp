JWT_SECRET=change_this_to_a_long_random_secret_in_production
PORT=3001
# Comma-separated list of allowed frontends. On Render set this to your Pages URL.
# e.g. CLIENT_URL=https://deepak0kr0mishra.github.io,http://localhost:5173
CLIENT_URL=http://localhost:5173
# Where SQLite + uploads live. Locally defaults to <repo-root>/data.
# On Render this MUST match the disk mountPath in render.yaml.
DATA_DIR=./data
# Password for seeding the fixed admins (Admin_01..Admin_05).
# SET THIS in the Render dashboard (Environment tab) — never commit the real value.
# Local dev default is '***REMOVED***' when this is unset.
ADMIN_PASSWORD=change_this_in_production_via_dashboard
